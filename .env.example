# Pioneer Builders: configuration (copy to .env.local)
# Nothing here is invented. Leave blank until the real value is confirmed.

# Final public URL, e.g. https://example.co.in (enables canonical URLs, sitemap, Open Graph URL)
NEXT_PUBLIC_SITE_URL=

# Enquiry fallbacks (the form opens these with the enquiry pre-filled)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format, digits only, e.g. 919XXXXXXXXX
NEXT_PUBLIC_WHATSAPP=
